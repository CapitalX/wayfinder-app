{
  "name": "wayfinder",
  "version": "1.40.0",
  "description": "Wayfinder: a self-hosted ServiceNow workspace with an AI companion (Pip), connected to your own instance.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/main.ts",
    "typecheck": "tsc -p .",
    "token": "tsx src/server/token.ts",
    "smoke": "tsx ops/smoke.ts",
    "test:ui": "node ops/ui/flows.mjs",
    "check:fluent": "tsx ops/check-fluent.ts",
    "eval:placement": "tsx ops/placement-eval.ts",
    "eval:context": "tsx ops/context-size.ts",
    "eval:baseline": "tsx ops/context-size.ts --write"
  },
  "keywords": [],
  "author": "The Wayfinder authors",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "private": "true",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@servicenow/sdk": "^4.14.0",
    "@servicenow/sdk-api": "^4.14.0",
    "hono": "^4.13.14",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@servicenow/isomorphic-rollup": {
      "joi": "17.13.9"
    },
    "@servicenow/sdk-cli": {
      "undici": "7.30.1"
    },
    "zod": "$zod"
  }
}
